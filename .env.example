# Copy to .env for local runs. On Railway set these as service variables instead.

# Telegram bot token (BotFather). Default is baked in but override here if it changes.
BOT_TOKEN=8720609626:AAGnPhsYh-YibivdJ5snXcnfdTaL1WtRQTY

# Destination Google Spreadsheet ID (the part of the URL between /d/ and /edit).
SHEET_ID=1fwrMFpywqv_y7Ko570tbtXHeo65YfL4XEwsJZxMhtRA

# Optional: tab name inside that spreadsheet. Empty = first tab.
WORKSHEET_NAME=

# Optional: tab name inside the uploaded Excel file to read. Default: Leads
SOURCE_SHEET_NAME=Leads

# Optional: comma-separated Telegram user IDs allowed to use the bot. Empty = everyone.
ALLOWED_USER_IDS=

# Google service account credentials.
# Local: put the JSON file next to the bot as service_account.json (no var needed).
# Railway: paste the ENTIRE JSON as one line here.
GOOGLE_CREDENTIALS_JSON=
